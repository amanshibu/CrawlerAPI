{
  "targetUrl": "https://my.geodis.com/",
  "maxDepth": 3,
  "maxConcurrency": 2,
  "requestTimeoutMs": 15000,
  "resultsDir": "./results",
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
  "sensitiveHeaders": [
    "authorization",
    "cookie",
    "x-api-key",
    "xsrf-token",
    "csrf-token",
    "bearer"
  ],
  "excludedExtensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".svg",
    ".css",
    ".woff",
    ".woff2",
    ".ttf",
    ".ico",
    ".mp4",
    ".pdf"
  ],
  "manualLogin": true,
  "manualLoginTimeoutMs": 60000,
  "sessionFile": "./session.json",
  "formFuzzing": false
}